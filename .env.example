# Copy to .env and edit. NEVER commit a real .env (see .gitignore).
# No secrets are required for Phase-1; these are deployment knobs only.

# Public HTTP port exposed by nginx on the host.
HTTP_PORT=80

# Comma-separated list of origins allowed to call the backend API.
# In production set this to your real domain, e.g. https://lab.example.edu
ALLOWED_ORIGINS=http://localhost
