# Secrets / local env
.env
.env.local
*.env.local

# Node
node_modules/
frontend/.next/
frontend/out/

# Python
__pycache__/
*.pyc
backend/.venv/

# Model binaries (keep the directory via .gitkeep, ignore large weights).
# Small, deployable artifacts are committed per-model so the server gets them on pull.
backend/model_artifacts/*
!backend/model_artifacts/.gitkeep
!backend/model_artifacts/kawasaki_ivig/
!backend/model_artifacts/kawasaki_ivig/**

# OS / editor
.DS_Store
*.log

# Working assets (raw source images etc.) — optimized outputs go in frontend/public
Materials/

# Stray root lockfile (no root package.json; frontend has its own)
/package-lock.json
